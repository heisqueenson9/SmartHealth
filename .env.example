# ─── Smart Health Sync Environment Configuration ───────────────
FLASK_ENV=development
SECRET_KEY=smarthealthsync-dev-secret-2026
LOG_LEVEL=INFO

# Database connection URL (SQLite fallback is used if omitted)
DATABASE_URL=your-database-url

# Groq API Key (Get a free key at https://console.groq.com/)
GROQ_API_KEY=your-groq-api-key-here

# Super Admin Seed Credentials (Optional - defaults are used if omitted)
ADMIN_EMAIL=your-admin-email
ADMIN_USERNAME=your-admin-username
ADMIN_PASSWORD=your-admin-password

# ─── Mail (Resend HTTP API) ───────────────────────────────────
# Optional: doctor approval/rejection notifications are silently skipped if
# RESEND_API_KEY is not set. Get a key at https://resend.com/api-keys.
#
# MAIL_DEFAULT_SENDER must use a domain verified on the Resend account.
# The default `onboarding@resend.dev` is Resend's shared sandbox sender and
# works only for testing against the address tied to your Resend account.
RESEND_API_KEY=your-resend-api-key
MAIL_DEFAULT_SENDER=Smart Health Sync <onboarding@resend.dev>
